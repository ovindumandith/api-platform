# Copy this file to .env.runpod and fill in your values:
#   cp env.runpod.example .env.runpod
# .env.runpod is gitignored and never committed.
#
# Hugging Face token — required to download gated models (Llama Guard 3, Granite Guardian).
# Generate one at https://huggingface.co/settings/tokens with read access.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# These point at the local vLLM containers defined in docker-compose.runpod.yaml.
# No changes needed unless you alter the service names or ports in that file.
APIP_GW_GRANITE__GUARDIAN__ENDPOINT=http://vllm-granite-guardian:8001
APIP_GW_NEMOGUARD__ENDPOINT=http://vllm-nemoguard:8002
